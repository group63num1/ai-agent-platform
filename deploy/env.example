# ==================== 项目配置 ====================
# 项目名称（用于容器命名）
PROJECT_NAME=ai-agent

# 时区设置
TZ=Asia/Shanghai

# ==================== 数据库配置 ====================
# MySQL 配置
MYSQL_PORT=3306
MYSQL_DATABASE=demo_db
MYSQL_ROOT_PASSWORD=123456

# AI 独立数据库（新库 new_db）
AI_MYSQL_PORT=3307
AI_MYSQL_DATABASE=new_db
AI_MYSQL_ROOT_PASSWORD=123456

# ==================== 后端服务配置 ====================
# Spring Boot 后端端口
BACKEND_PORT=8080

# Spring Boot 环境配置
SPRING_PROFILES_ACTIVE=prod

# Java 运行参数
JAVA_OPTS=-Xms512m -Xmx1g

# ==================== AI Agent 服务配置 ====================
# AI Agent 端口
AI_AGENT_PORT=8000

# AI Agent 调试模式
AI_AGENT_DEBUG=false

# AI Agent 日志级别
AI_AGENT_LOG_LEVEL=INFO

# AI Agent 数据库连接池配置
AI_AGENT_DB_POOL_SIZE=5
AI_AGENT_DB_MAX_OVERFLOW=10

# AI Agent 后端超时配置
AI_AGENT_BACKEND_TIMEOUT=30

# AI Agent RAG 配置
AI_AGENT_CHUNK_SIZE=1000
AI_AGENT_CHUNK_OVERLAP=200
AI_AGENT_RETRIEVAL_K=3

# AI Agent Agent 配置
AI_AGENT_MAX_ITERATIONS=5
AI_AGENT_MAX_HISTORY_LENGTH=20
AI_AGENT_SUMMARY_TRIGGER=16
AI_AGENT_VERBOSE=true

# AI Agent 插件配置
AI_AGENT_PLUGIN_TIMEOUT=30
AI_AGENT_PLUGIN_MAX_RETRIES=3

# AI Agent CORS 配置（多个用逗号分隔）
AI_AGENT_CORS_ORIGINS=*

# AI Agent 向量数据库（Milvus）配置
MILVUS_ENABLE=true
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_METRIC_PORT=9091
MILVUS_ALIAS=default
MILVUS_COLLECTION_NAME=knowledge_base
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin
MILVUS_MINIO_PORT=9000
MILVUS_MINIO_CONSOLE_PORT=9001

# ==================== PyPI 加速源（可选） ====================
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 如果有私有/备用源，按需填写；否则留空
PIP_EXTRA_INDEX_URL=

# ==================== 前端服务配置 ====================
# 前端管理端端口
WEB_ADMIN_PORT=80

# Node.js 环境
NODE_ENV=production

# ==================== 数据库管理工具配置 ====================
# PHPMyAdmin 端口
PHPMYADMIN_PORT=8081
PHPMYADMIN_AI_PORT=8082

